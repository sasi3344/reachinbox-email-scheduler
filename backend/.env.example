PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379

# Google OAuth Credentials
# For real OAuth, obtain these from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session & JWT Secret
SESSION_SECRET=reachinbox-super-secure-session-secret-change-in-production
JWT_SECRET=reachinbox-jwt-secret-key-change-in-production

# Ethereal Email SMTP Credentials
# Create free test account at https://ethereal.email/create or leave empty for auto-generated test account
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker & Queue Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Frontend URL
FRONTEND_URL=http://localhost:5173
